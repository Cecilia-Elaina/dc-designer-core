{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dc-designer-core/schemas/v1-skill-graph.schema.json",
  "title": "v1 信息科技教学分析技能图",
  "description": "目的操作流程、从属技能层级和可选程序控制流使用同一组稳定节点编号，但以独立视图表达不同语义。",
  "type": "object",
  "required": ["goal_node", "goal_steps", "subordinate_skills", "entry_behaviors", "view_validation"],
  "properties": {
    "graph_id": {"type": "string"},
    "topic": {"type": "string"},
    "analysis_method": {"type": "string"},
    "include_control_flow": {"type": "boolean"},
    "goal_node": {"$ref": "#/definitions/node"},
    "goal_steps": {
      "type": "array",
      "items": {"$ref": "#/definitions/step"}
    },
    "subordinate_skills": {
      "type": "array",
      "items": {"$ref": "#/definitions/skill"}
    },
    "entry_behaviors": {
      "type": "array",
      "items": {"$ref": "#/definitions/entry"}
    },
    "entry_behaviours": {
      "type": "array",
      "items": {"$ref": "#/definitions/entry"}
    },
    "edges": {"type": "array", "items": {"$ref": "#/definitions/edge"}},
    "view_validation": {
      "type": "object",
      "required": ["status", "errors"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["node_id"],
      "properties": {
        "node_id": {"type": "string"},
        "node_type": {"type": "string"},
        "label": {"type": "string"},
        "description": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "step": {
      "type": "object",
      "required": ["step_id", "order", "description"],
      "properties": {
        "step_id": {"type": "string"},
        "order": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1},
        "learning_type": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "skill": {
      "type": "object",
      "required": ["skill_id", "description", "linked_step_id"],
      "properties": {
        "skill_id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "learning_type": {"type": "string"},
        "linked_step_id": {"type": "string"},
        "parent_step_id": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "entry": {
      "type": "object",
      "required": ["entry_id", "description"],
      "properties": {
        "entry_id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "learning_type": {"type": "string"},
        "supports_skill_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "edge_type": {"type": "string"},
        "label": {"type": "string"}
      }
    }
  }
}
